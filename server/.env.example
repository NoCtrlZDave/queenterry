# Server
PORT=5000
NODE_ENV=development

# Database
# Local MongoDB: mongodb://127.0.0.1:27017/queen_terry
# MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/queen_terry
# In-memory (development only, requires mongodb-memory-server): memory://
MONGODB_URI=mongodb://127.0.0.1:27017/queen_terry

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Client
CLIENT_ORIGIN=http://localhost:5173

# Seed admin account (used by `npm run seed`)
ADMIN_NAME=Queen Terry Admin
ADMIN_EMAIL=admin@queenterry.test
ADMIN_PASSWORD=ChangeMe123!
ADMIN_PHONE=09025068558

# Store WhatsApp number in international format, digits only, no plus sign
WHATSAPP_NUMBER=2349025068558

# Set to false to skip demo products when seeding
SEED_DEMO=true
